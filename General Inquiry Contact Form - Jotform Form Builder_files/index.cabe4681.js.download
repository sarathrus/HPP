  ${({name:e})=>`\n    position: absolute;\n    ${e}: 0;\n    border-${e}: 1px solid #ff18ff;\n  `}

  &.y {
    top: 0;
    width: 1px;
  }
  &.x {
    left: 0;
    height: 1px;
  }

  @keyframes appearSmoothly {
    from { opacity: 0; }
    to { opacity: 1; }
