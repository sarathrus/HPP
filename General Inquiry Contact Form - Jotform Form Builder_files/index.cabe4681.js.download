  .searchAndInvite {
    margin: -24px 0 18px 0;

    &-title {
      font-size: 15px;
      line-height: 18px;
      font-weight: 700;
    }

    &-subheader {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 30px;

      .jfCheckbox-item {
        padding: 6px;
      }
    }

    .searchInUsers {
      position: relative;

      &:before {
        content: '';
        background-image: url("data:image/svg+xml,%3Csvg fill='none' xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Cpath d='m15.2 13.73-3.17-3.17a6.36 6.36 0 1 0-1.47 1.46l3.17 3.18a1.04 1.04 0 0 0 1.47-1.47ZM3.83 9.89a4.28 4.28 0 1 1 6.06-6.06 4.28 4.28 0 0 1-6.06 6.06Z' fill='%236F76A7'/%3E%3C/svg%3E");
        background-size: 15px;
        background-position: center;
        position: absolute;
        display: inline-block;
        width: 15px;
        height: 15px;
        margin: 15px 12px;
      }
      
      input {
        background: #FFFFFF;
        border: 1px solid #D0D4EC;
        border-radius: 4px;
        padding: 12px 12px 12px 32px;

        input {
          border: none;
        }
      }
    }

    .inviteMultiple {
      background: #78BB07;
      border-radius: 4px;
      color: #FFFFFF;
      border: none;
      cursor: pointer;
      padding: 12px 40px;
  
      &:hover {
        background: #4EB100;
      }
    }
  }

  .jfTable-wrapper {
    height: 400px;
    overflow: auto;
  }

  table {
    border-collapse: collapse;
    width: 100%;

    tbody {
      .jfTable-row {
        border-top: 1px solid rgba(94,105,137,0.33);
      }
    }

    .forCheckbox,
    .forUser {
      text-align: left;
    }

    .forStatus {
      text-align: right;
    }

    .jfTable-row {
      position: relative;

      .jfCheckbox-wrapper.isChecked {
        background: #0099FF;
      }
    }

    .jfTable-column {
      &.forCheckbox {
        margin: 0;
        padding: 0;
        width: 24px;

        .jfCheckbox-item {
          padding: 0;
          width: 22px;
          height: 22px;

          .jfCheckbox-wrapper {
            left: 0;
          }
        }
      }

      &.forUser {
        display: flex;

        .user-avatar {
          width: 30px;
          height: 30px;
          border-radius: 50%;
          background-position: center;
          background-repeat: no-repeat;
          background-size: cover;
        }

        .user-content {
          display: flex;
          margin-left: 8px;
          flex-direction: column;

          .name {
            font-weight: 600;
            font-size: 14px;
            line-height: 18px;
          }

          .email {
            font-weight: 400;
            font-size: 12px;
            line-height: 16px;
          }
        }
      }
    }

    .inviteSingle {
      background-color: #E3E5F5;
      border-radius: 4px;
      color: #545B88;
      border: none;
      cursor: pointer;
      padding: 10px 24px;
  
      &:hover {
        background: #bebfcf;
      }

      &.invited {
        pointer-events: none;
        background-color: transparent;
      }
    }
  }
