    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    padding: 8px;
    z-index: 1002;

    &>div{
        display: flex;
        align-items: flex-end;
        justify-content: flex-end;
        padding-right: 32px;
        padding-bottom: 48px;

        ${({overlayVisible:e})=>!0===e?"\n              background-color: rgba(10,21,81,.7)!important;\n              ":!1===e?"\n            pointer-events: none;\n            background-color: transparent!important;\n\n              &>div{\n                  &>div{\n                    box-shadow: 8px 8px 32px rgba(41, 42, 61, 0.1), 0px 0px 16px rgba(41, 42, 61, 0.1);\n                  }\n              }\n              ":void 0}


        &>div{
            max-height: 100vh;
            pointer-events: all;
            &>div{
                max-width: 400px;
                width: 100%!important;
                border-radius: 8px;
                position: relative;
                padding: 0!important;
                margin: 0 auto!important;
                background-color: #493cff!important;

                &:before{
                    content: "";
                    clear: both;
                    display: table;
                }
            }
        }
    }
