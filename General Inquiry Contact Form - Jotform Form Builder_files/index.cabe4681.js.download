  @media screen and (max-width: 980px) {
    .customLink-pre {
      max-width: 240px;
      text-overflow: ellipsis;
      white-space: nowrap;
      overflow: hidden;
      font-size: 14px;

      input {
        font-size: 14px;
      }
    }
  }

  @media screen and (max-width: 480px) {
    .linkBox.isEditing { position: relative; margin-bottom: 3.5rem !important; }

    // .section { padding: 1em .75em; }
    .sectionTitle .dash { display: none; }
    .sectionTitle .sub { margin-top: .25rem; display: block; }
    .section-action { flex-direction: column-reverse; align-items: stretch; }
    .section-action.forSend {
      flex-direction: column;

      .bare { align-self: flex-start; margin-bottom: 01em; padding: .5em 0; }
    }
    .actionMessage {
      // padding: 1em 0 0;
      flex-direction: column;

      .forSuccess { text-align: left; margin-left: 0; margin-top: .5rem; }

      .forGenerate [data-type="btn-label"] { display: none; }
      .forGenerate svg {
        display: block;
          height: 20px; width: 20px;
          margin: 0 2px;
      }

    }
    .inviteTop { flex-direction: column; align-items: flex-start; }
    .inviteTop .sectionTitle { order: 2; margin: 1.5em 0 .5em; display: flex; align-items: center; }

    .avatarList { order: 1; margin-left: 0; }
    .avatarText { padding-left: 0; }

    .wBox-upper { padding-right: 0; }

    .wBox-isError {
      min-height: 475px;
    }

    .plbx-wr {
      & > div { max-height: max(36vh, 240px); overflow: auto; }
      // input { padding-bottom: 36px; }
      .pill + input { max-width: unset; }
    }
    input, textarea { &::placeholder { font-size: 12.5px; } }

    .customLink-pre { max-width: 42vw; font-size: 12px; }

    .sepButtonShell.fa { position: absolute; bottom: -3em; right: 0; }
    .sepButtonShell.fa:before { display: none; }
  }

  .invite-section.forNewAssign {
    .forSend {
      margin-top: 32px;
    }

    &.isExpanded {
      .border-t {
        display: inline-block;
        border-width: 0;
        margin: 1rem 0;
      }
    }
  }
