  &, &:before, &:after {
    width: 10px;
    height: 10px;
    position: absolute;
  }

  [data-popper-placement="top-end"] & {
    bottom: -10px;

    &:before { top: -4px; }
    &:after { top: -6px; }
  }

  [data-popper-placement="bottom-end"] & {
    &:before { top: -6px; }
    &:after { top: -4px; }
  }

  &:before, &:after {
    content: "";
    display: inline-block;
    transform: rotate(45deg);
    left: 0px;
  }

  &:before {
    background: rgba(216, 218, 233, 0.5);
    z-index: 1;
    border-radius: 1px;
  }

  &:after {
    background: #fff;
    z-index: 2;
