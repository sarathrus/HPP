  background: transparent;
  display: flex;
  align-items: center;
  border-radius: 2px;
  border: 0;
  box-shadow: none;
  font-size: 14px;
  line-height: 1.25;
  padding: 0;
  cursor: pointer;

  .dd-t { flex: 1 1 auto; padding: .5em 0; color: #0075E3; text-align: right; font-size: 12px; line-height: 16px; font-weight: 500; white-space: nowrap; }
  .dd-s { padding: .4em; color: #0075E3; }
  .dd-s svg { display: block; width: 12px; height: 12px; }
  .dd-s svg path { stroke: #0075E3 !important}
  .dd-i { display: block; color: #ff0000; font-size: .95em; }

