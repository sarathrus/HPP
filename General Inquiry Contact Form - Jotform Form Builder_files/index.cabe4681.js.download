`,on=c.ZP.ul.attrs({role:"listbox"})`
  list-style: none;
  margin: 0;
  padding: .25em 0;
  background-color: #fff;
  border: 1px solid #d8dae9;
  font-size: .875em;
  border-radius: 4px;
  box-shadow: 0 0 9px 0 rgba(0, 0, 0, 0.16);

  .i {
    padding: 1rem 1rem .875rem 1.5rem;
    user-select: none;
    cursor: pointer;
    line-height: 1.25;
  }
  li {
    display: flex;
    align-items: center;
    position: relative;
    z-index: 1;
    &:before {
      flex-shrink: 0;
      content: "";
      background-repeat: no-repeat;
      background-position: center;
      background-size: 16px;
      position: relative;
      display: inline-flex;
      width: 24px;
      height: 24px;
      border-radius: 100%;
      margin-left: 24px;
      background-color: #E6E9EF;
    }
    &[aria-selected=true] {
      &:before {
        background-color: #0099FF;
        background-image: url(data:image/svg+xml;base64,);
      }
    }
  }

  li + li { border-top: 1px solid #eaebf2; }

  li:hover,
  li.isHovering { background-color: #F3F4F7; }

  .il { font-size: 14px; color: #2c3345; font-weight: 700; }
