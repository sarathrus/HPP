  display: flex;
  flex-direction: column;
  align-items: center;
  overflow-y: auto;

  .content {
    width: 90%;
    max-width: 500px;
    padding-bottom: 40px;
    text-align: center;
    font-size: 1em;
    color: #0A1551;
    font-weight: 700;
    margin: auto;
  }

  .content.wider { max-width: 540px; }

  svg { margin-bottom: 30px; margin-top: 56px; }
  .assignToOrgSvg {
    width: 54vw;
    height: 36vh;
    max-width: 192px;
    max-height: 136px;
  }

  .title {
    font-size: 16px;
    color: #0A1551;
    font-family: "Circular",Work Sans Medium,-apple-system,Helvetica Neue,sans-serif;
    font-weight: 500;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  p {
    margin-top: 9px;
    font-size: 14px;
    line-height: 24px;
    font-weight: 400;
    height: 18px;
    color: #6F76A7;
    font-family: "Circular",Work Sans Medium,-apple-system,Helvetica Neue,sans-serif;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media screen and (max-width: 480px) {
    font-size: 0.875em;

    p { margin: 1em 0 .75em; }
  }  
