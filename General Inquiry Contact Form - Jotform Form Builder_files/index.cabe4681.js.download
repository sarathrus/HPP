  display: inline-block;
  width: 100%;
  font-size: 1em;
  border: 1px solid #ccc;
  border-radius: 2px;
  padding: .5em;
  cursor: text;

  .pill {
    color: #2c3345;
    height: 28px;
    border-radius: 15px;
    background-color: #ebedf3;
    display: inline-flex;
    align-items: center;
    padding: 0 .5em;
    margin: 0 .375em .25em 0;
    cursor: default;

    &.hasBackgroundColor:not(.isBright) {
      color: #fff;
    }

    &-remove {
      width: 12px;
      margin-left: .375em;
      cursor: pointer;
      order: 3;

      svg {
        display: block;
        fill: currentColor;
      }
    }
  }

  .emailInput-input {
    font-size: .875em;
    padding: .5em;
    border: 0;

    &:focus { outline: 0; }
  }
