  display: flex;
  position: relative;
  flex-direction: column;
  padding: 8px 0;
  flex-flow: row wrap;
  width: 100%;

  .ReactVirtualized__Grid {
    overflow: hidden auto !important;
  }

  .user-wrapper {
    display: flex;
    flex-direction: row;
    gap: 12px;
    flex-grow: 1;
    width: 100%;
    padding: 10px 12px;
    align-items: center;
    height: 52px !important;

    &:hover {
      cursor: pointer;
      background-color: #F3F3FE;
    }

    .user-information {
      display: flex;
      flex-direction: column;
      font-weight: 400;
      font-size: 14px;
      line-height: 16px;

      .user-name {
        color: #0A1551;
      }

      .user-email {
        color: #6C73A8;
      }
    }
  } 
