    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: #ffffff;
    z-index: 1020;
    box-shadow: 0px 0px 24px 0px rgba(43, 50, 69, 0.25);
    display: flex;
    animation-name: ${Xb};
    animation-duration: .25s;
    animation-fill-mode: forwards;
    animation-timing-function: ease-in;
`,ry=AC.ZP.div`
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: stretch;
`,sy=AC.ZP.button`
    display: flex;
    align-self: auto;
    align-items: center;
    justify-content: center;
    text-align: left;
    height: 64px;
    font-weight: 400;
    font-style: normal;
    font-size: 12px;
    line-height: 16px;
    border: none;
    background: transparent;
    position: relative;
    padding: 8px 40px;
    cursor: pointer;
    color: #2B3245;
    letter-spacing: 0.35px;
    transition: color .2s, background-color .2s;
    margin: 0;
    text-align: center;

    @media ${ny} {
      padding: 8px 30px;
    }

    @media ${ay}, ${oy} {
      padding: 8px 16px;
      height: 48px;
    }

    &:after{
      content:"";
      display: block;
      width: 0;
      height: 0;
      border-radius: 50%;
      position: absolute;
      left: 24px;
      top: 32px;
      transition: all .2s;
    }

    &:hover{
      background-color: #F8FBFF
      // color: #4644ff;
      // &>div{
      //   background-color: #9392ff;
      // }
    }

    &>div{
      &:before{
        transition: width 1s;
        width: 0%;
      }
      &:after{
        transition: width 1s;
        width: 0%;
      }
    }

    ${({status:e})=>"notStarted"===e?"\n      ":"inProgress"===e?`\n        color: #2B3245;\n        font-weight: 700;\n        letter-spacing: 0.05px;\n        \n        &>div{\n          &:before{\n            background-color: ${ty};\n            width: 100%;\n          }\n          &:after{\n            background-color: ${ty};\n            width: 100%;\n            right: inherit;\n            left: 0;\n          }\n        }\n          `:"completed"===e?`\n        font-weight: 700;\n        letter-spacing: 0.05px;\n        color: #26A65B;\n        &::after{\n            width: 16px;\n            height: 16px;\n            left: 16px;\n            top: 24px;\n            background: ${ey};\n            border-color: ${ey};\n            background-image: url("data:image/svg+xml,%3Csvg width='8' height='6' viewBox='0 0 8 6' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 3L3 5L7 1' stroke='white' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E%0A");\n            background-repeat: no-repeat;\n            background-position: center;\n\n            html[dir="rtl"] & {\n              left: inherit;\n              right: 16px;\n            }\n\n            @media ${ny} {\n              left: 10px;\n\n              html[dir="rtl"] & {\n                left: inherit;\n                right: 10px;\n              }\n            }\n\n            @media ${ay}, ${oy} {\n              left: 2px;\n              top: 17px;\n              width: 12px;\n              height: 12px;\n              background-size: 6px;\n\n              html[dir="rtl"] & {\n                left: inherit;\n                right: 2px;\n              }\n            }\n\n        }\n\n        &>div{\n          background: ${ey};\n          &:before{\n            background-color: ${ey};\n            width: 0%;\n          }\n        }\n\n        &:hover{\n          color: #26A65B;\n          &>div{\n            background-color: ${ey};\n          }\n        }\n\n        `:void 0}
`,ly=AC.ZP.div`
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 8px;
  background-color: #C3CAD8;
  transition: background .2s;

  &:before{
    content: "";
    display: block;
    width: 0%;
    height: 8px;

    ${({status:e})=>{if("inProgress"===e)return`\n        background-color: ${ty};\n      `}}

  }

  &:after{
    content: "";
    display: block;
    width: 0%;
    height: 8px;
    position: absolute;
    right: 0;
    bottom: 0;
    background: ${ty};
    transition: all .2s;

    html[dir="rtl"] & {
      right: inherit;
      left: 0;
    }

  }

`,cy=AC.ZP.div`
