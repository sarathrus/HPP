`),Ry=AC.ZP.div`
    padding: 32px;

    &>p{
        font-size: 16px;
        line-height: 24px;
        font-weight: 400;
        margin-block-start: 0;
        margin-block-end: 0;
        &>p{
            margin-block-start: .75rem;
            margin-block-end: 0;
        }
    }

    a{
        color: #2E69FF;
        text-decoration: underline;
        transition: color .2s;

        &:hover{
            color: #134fe8;
        }
    }
`,Dy=AC.ZP.h2`
    margin: 0;
    font-weight: 700;
    font-size: 16px;
    line-height: 24px;
    color: #2B3245;
`,Ly=AC.ZP.div`
    background: #F8FBFF;
    border-top: 1px solid #E6EBF2;
    padding: 24px 32px;
    display: flex;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;

    &>button{
        &+button{
            margin-left: auto;
        }
    }
`,Fy=AC.ZP.button`
    background: transparent;
    color: #57647E;
    border: 1px solid #b5bed1;
    border-radius: 4px;
    font-size: 16px;
    line-height: 24px;
    padding: 8px 16px;
    cursor: pointer;
    transition: all .2s;

    &:hover{
        background-color: #E6EBF2;
        border-color: #E6EBF2;
    }
`,jy=AC.ZP.button`
    background: #5C5CFF;
    color: #ffffff;
    border-radius: 4px;
    border:none;
    font-size: 16px;
    line-height: 24px;
    padding: 8px 16px;
    cursor: pointer;
    transition: background .2s;

    &:hover{
