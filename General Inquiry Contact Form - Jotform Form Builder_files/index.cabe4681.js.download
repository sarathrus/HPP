  display: flex;
  position: relative;

  .dropdown-option-content {
    display: flex;
    padding: 16px;
  }
  
  .radio {
    position: absolute;
    visibility: hidden;
    opacity: 0;
    width: 28px;
    height: 28px;

    &.isSelected + label {
      &:before {
        background-color: #4277FF;
        background-image: url("data:image/svg+xml,%3Csvg fill='none' xmlns='http://www.w3.org/2000/svg' viewBox='0 0 14 10'%3E%3Cpath d='M.9 4.44 4.73 8.9l7.64-7.64' stroke='%23fff' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
        background-size: 12px 8px;
        background-repeat: no-repeat;
        background-position: center;
      }
    }

  }

  label {
    position: relative;
    padding-left: 42px;
    cursor: pointer;

    &:before {
      content: '';
      border-radius: 100%;
      width: 28px;
      height: 28px;
      background-color: #F2F3FB;
      position: absolute;
      left: 0;
      top: 50%;
      margin-top: -14px;
    }

    p {
      margin: 0;
      padding: 0;
      color: #2D3344;
      font-size: 15px;
      font-weight: 700;
      line-height: 20px;
      margin-bottom: 4px;
    }

    span {
      font-size: 15px;
      line-height: 20px;
      font-weight: 400;

      span, b {
        font-weight: 700;
      }
    }
  }
