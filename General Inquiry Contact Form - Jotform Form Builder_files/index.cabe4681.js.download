  display: flex;
  height: 68px;
  border: ${()=>`1px solid ${We}`};
  align-items: center;
  padding: 10px;
  border-radius: 4px;
  position: relative;
  cursor: pointer;
  justify-content: space-between;
  .icon-wrapper-rounded {
    height: 32px;
    align-items: center;
    font-size: 14px;
    border: 1px solid #C8CEED;
    color: #0A1551;
    padding: 8px 16px;
    border-radius: 4px;
    display: none;
    svg {
      width: 18px;
      margin-right: 6px;
      * {
        fill: #0A1551;
      }
    }
  }
  .icon-wrapper-circle {
    width: 20px;
    height: 20px;
    border-radius: 100%;
    position: absolute;
    right: 20px;
    background: #D4D6E1;
    justify-content: center;
    display: flex;
    align-items: center;
    display: flex;
    svg {
      width: 18px;
      height: 18px;
      * {
        fill: #ffffff;
      }
    }
    &.added {
      background: #4277FF;
    }
  }
  &:hover {
    box-shadow: 0px 4px 10px rgb(0 0 0 / 10%);
    .icon-wrapper-circle {
      background: #81829E;
    }
    .icon-wrapper-rounded {
      display: flex;
      z-index: 2;
    }
    .icon-wrapper-circle {
      display: none;
    }
    p {
      max-width: calc(100% - 20px);
      text-overflow: ellipsis;
      white-space: nowrap;
      overflow: hidden;
    }
  }
  &.active {
    border-color: #4277FF;
    .icon-wrapper-circle {
      background: #4277FF;
    }
  }

  &.hasWarning {
    height: 100px;

    .missingPDFWarning {
      display: flex;
      gap: 4px;
      color:  #F9A400;
      font-family: Circular;
      font-size: 12px;
      font-style: normal;
      font-weight: 400;
      line-height: 16px;
      margin-bottom: 0;
    }
  }
`,dt=h.ZP.ul`
  list-style-type: none;
  margin: 0;
  padding: 0;
  width: 100%;
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-gap: 12px;
  &.oneCol {
    grid-template-columns: 1fr;
  }
`,ut=h.ZP.label`
  display: flex;
  align-items: center;
  color: #3E62C8;
  svg {
    width: 24px;
    height: 24px;
  }
  span {
    margin-left: 10px;
    color: #0A1551;
    font-weight: 400;
  }
`,pt=h.ZP.div`
width: 100%;
display: flex;
flex-direction: column;
font-family: Circular;
color: #0A1551;
min-height: 0px;
.resourceDropdown {
  &-detailText {
    font-size: 13px;
  }
&-input {
  min-height: 56px;
  padding: 8px 46px 8px 66px;
  margin-right: 16px;
  max-width: 78%;
  &before {
    height: 24px;
  }
  &:not([data-selected='true']) {
    color: #6F76A7;
    svg path {
      fill: #C8CEED;
    }
    &:before {
    background-image: url(data:image/svg+xml;base64,);
    }
  }
  &.downloadPDF {
    cursor: pointer;
    max-width: 100%;
    margin-right: 0;
    margin-bottom: 20px;
  }
}

&-option:hover:before {
    background-color: transparent;
}
&-option.isActive:hover:before {
    background-color: #4277FF;
}
}
.downloadPDF-item {
  display: flex;
  align-items: center;
  margin-bottom: 8px;
  .input-gray {
    width: 100%;
    height: 54px;
    .pdfList-item {
      display: flex;
      align-items: center;
      span {
        margin-left: 10px;
        color: #0A1551;
      }
    }
  }
  .pdf-item-link {
    color: #6F76A7;
    svg {
      width: 20px;
      height: 20px;
    }
  }
}
.jfCheckbox-inputText {
  font-size: 15px;
}
.prefill-container {
  display: flex;
  align-items: center;
  margin-bottom: 0.5em;

  .resourceDropdown-formData {
    max-width: 100%;
  }

  .form-actions {
    position: absolute;
    right: 6%;

    .jfButton {
      height: 32px;
      width: 32px;
      background-color: #4E79F6;
      border-radius: 4px;
    }

    div:first-child {
      margin-right: 8px;
    }
  }
  &.emails {
    position: relative;
    .resourceDropdown-formData {
      margin-right: 0;
    }
  }
}
.view-switch {
  .jfButton {
    background-color: #E0E3F1;
    text-align: center;
    color: #000;
    padding: 12px 36px;
    &.selected {
      color: #fff;
      background-color: #4277FF;
    }
  }
  .jfButton:first-child {
    border-radius: 4px 0px 0px 4px;
  }
  .jfButton:last-child {
    border-radius: 0px 4px 4px 0px;
  }
}
.prefill-settings {
  border: 1px solid #6F76A7;
  border-radius: 4px;
  white-space: nowrap;
  height: 40px;
  display: flex;
  align-items: center;
  color: #0A1551;
  padding: 0 16px;
  flex: 1 1 auto;
  justify-content: center;
  &.setted {
    background: #01BD6F;
    border:none;
    &:hover {
      background: #16AA52;
    }
  }
  &.isEnabled {
    background-color: #18BD5B;
    color: #fff;
    border: none;
    padding-left: 16px;

    &:hover {
      background-color: #70c994;
    }
  }
  :hover {
    background-color: #F3F3FE;
  }
  &[disabled] {
    border-color: transparent;
    color: #fff;
    background: #545B88;
    padding-left: 16px;
  }
  .jfButton-icon {
    display: flex;
    align-items: center;
    position: relative;
    top: auto;
    transform: none;
    left: auto;
    margin-right: 8x;
    svg {
      width: 20px;
      height: 20px;
    }
  }
}
.form-name {
  flex: 1 1 100%;
  width: 50%;
  display: flex;
  max-width: calc((100% - 64px) / 2);
  & + .form-name {
    margin-left: 14px;
  }
  &-wrapper {
    display: flex;
    flex-wrap: nowrap;
    margin-bottom: 8px;
  }
  &-icon {
    display: inline-flex;
    margin-right: 6px;
    svg {
      width: 20px;
      height: 20px;
    }
  }
  span {
    max-width: 100%
    display: inline-block;
    text-overflow: ellipsis;
    overflow: hidden;
    white-space: nowrap
  }
}
.jfButton-children {
  display: flex;
  align-items: center;
  white-space: nowrap;
    svg {
      width: 22px;
      height: 22px;
      margin-right: 8px;
    }
}
.primary-label {
  color: #0A1551;
  font-size: 16px;
  margin-bottom: 8px;
  font-weight: 500;
  display: block;
  margin: 0;
  margin-bottom: 8px;
}
.secondary-label {
  color: #6F76A7;
  font-size: 15px;
  margin-bottom: 8px;
  font-weight: 400;
  display: block;
  margin: 0;
  line-height: 22px;
}
.jfCheckbox-wrapper {
  width: 18px;
  height: 18px;
  margin-right: 5px;
  border-color: #C8CEED;
  &:not(.isChecked) {
    background: transparent;
  }
}
.jfCheckbox-check {
  background: transparent;
}
.input-gray {
  height: 42px;
  color: #0A1551;
  padding: 0 16px;
  font-size: 15px;
  border-radius: 4px;
  background: transparent;
  display: flex;
  border: 1px solid #D8DAE8;
  width: 100%;
  align-items: center;
  &.withBorder {
    border: 1px solid #D8DAE8;
    display: flex;
    justify-content: space-between;
  }
  label {
    display: flex;
    cursor: pointer;
    font-size: 15px;
    color: #3E62C8;
    svg {
      width: 24px;
      height: 24px;
    }
  }
  &:focus, &:active {
      border-color: #4277FF;
    }
}
.pdf-multiselect-list-item {
  .input-gray {
    border: none;
  }
  & + & {
    margin-top: 8px;
  }
}

.subText {
  margin: 0;
  font-size: 15px;
  font-weight: 400;
}
.jfPrefill {
  &-matchText {
    display: none;
  }
}
.pdfList {
 &-icon * {
  fill: #6F76A7;
}
 &-item {
  cursor: pointer;
  &:hover {
    .pdfList-icon * {
      fill: #4277FF;
    }
  }
 }
}
.jfCheckbox-item {
  .jfCheckbox-wrapper {
  width: 16px;
  height: 16px;
  border-color: #C8CEED;
  }
  &.isChecked {
    .jfCheckbox-wrapper {
      border-color: transparent;
    }
    .jfCheckbox-check .jfCheckbox-checkmark {
      transform: rotate(-45deg) translateY(-4px) translateX(1px) scale(0.7);
    }
  }
}
.footer-button {
  &.accept {
    background: #5C89FF;
    &:hover {
      background: #4277FF;
    }
  }
  &.back {
    color: #2B3245;
    border-color: #C3CAD899;
    &:hover {
      background: #C3CAD81A !important;
    }
  }
}
.resourceDropdown-input.isDisabled:hover {
    border-color: #CCD0E4;
    pointer-events: none;
}
.resourceDropdown-input.isActionButtons {
  padding: 8px 44px 8px 16px;
  .resourceDropdown-inputText {
    font-weight: 400;
    display: flex;
    align-items: center;
    svg {
      width: 26px;
      height: 26px;
      margin-right: 6px;
    }
  }
  .pdfList-item {
    display: flex;
    align-items: center;
    span {
      margin-left: 12px;
    }
  }

}

.passwordWithToggleWrapper {
  .pdfPasswordToggle {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .pdfPassword-input > div {
    max-width: 100%;
  }

  .forPassword {
    margin-top: 12px;
    margin-bottom: 8px;
    padding-bottom: 0;
    

    .hPass-reqs {
      margin-bottom: 0;
    }   

    .forDisclaimer {
      font-size: 14px;
      color: #DC2626;
    }
  }
}

.hasWarning {
  .resourceDropdown-input.downloadPDF {
    border: 1px solid #FFB629;
  } 
}

div:not([class]) ~ div:has(.passwordWithToggleWrapper) {
  margin-top: 20px;
}

`,mt=h.ZP.div`
flex: 1 1 auto;
padding: 24px;
min-height: 0px;
overflow: auto;
`,ht=h.ZP.div`
& + & {
  border-top: 1px solid #EDEEF5;
  padding-top: 20px;
  margin-top: 20px;

  .preview-icon {
    margin: 0 8px;
    height: 24px;
    width: 24px;
  }
}
`,gt=h.ZP.footer`
  display: flex;
  justify-content: space-between;
  background: #EFEFF673;
  padding: 12px 24px;
  font-size: 15px;
  font-family: Circular;
  align-items: center;
  .btn-color {
    color: #4277FF;
    background: none;
    border: none;
    margin-left:8px;
    font-size: 15px;
    font-weight: 500;
    font-family: Circular;
  }
  p {
    margin: 0;
  }
`,ft=h.ZP.div`
  position: absolute;
  bottom: 10px;
  right: 16px;
  color: #6F76A7;
  svg {
    width: 20px;
